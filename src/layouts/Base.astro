---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Podróżujemy, kręcimy filmy, jemy roślinnie i podróżujemy świadomie.",
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">Przejdź do treści</a>
    <slot />
    <script is:inline src="/yt-facade.js"></script>
  </body>
</html>
