---
import type { Video } from "../data/videos";
import {
  countryForVideo,
  durationFor,
  initiallyCollapsed,
  metaLine,
} from "../lib/videoMeta";

interface Props {
  video: Video;
  index?: number;
  variant?: "grid" | "feature";
}

const { video, index = 0, variant = "grid" } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`;
const duration = durationFor(video);
const country = countryForVideo(video);
const collapsed = initiallyCollapsed(index, video.playlist);
const ariaLabel = `Odtwórz: ${video.title}`;
---

<article
  class:list={["card", "vcard", "video-card", variant === "feature" && "video-card--feature"]}
  data-yt-facade
  data-youtube-id={video.youtubeId}
  data-c={country}
  data-more={collapsed ? "" : undefined}
  hidden={collapsed ? true : undefined}
>
  <div class="video-card__player yt">
    <img
      class="video-card__thumb thumb"
      src={thumb}
      alt=""
      width="480"
      height="360"
      loading={variant === "feature" ? "eager" : "lazy"}
    />
    <button type="button" class="video-card__play play" aria-label={ariaLabel}>
    </button>
    {duration && <span class="dur">{duration}</span>}
  </div>
  {
    variant === "grid" && (
      <div class="card-body">
        <p class="meta">{metaLine(video)}</p>
        <h3>{video.title}</h3>
        <p class="video-card__notice">
          Odtworzenie ładuje YouTube i może zapisać ciasteczka YouTube.
        </p>
      </div>
    )
  }
</article>
