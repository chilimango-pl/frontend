---
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

const heroFile = fileURLToPath(new URL("../../public/hero.jpg", import.meta.url));
const hasHeroPhoto = existsSync(heroFile);
---

<section class="hero" aria-labelledby="hero-h">
  <div class="wrap">
    <div class:list={[hasHeroPhoto && "hero-split"]}>
      <div>
        <h1 id="hero-h">Chilimango</h1>
        <p class="hero-italic">rodzina w podróży</p>
        <p class="hero-lead">
          Podróżujemy, kręcimy filmy, jemy roślinnie i podróżujemy świadomie.
        </p>
        <a class="btn-ink" href="#filmy">Oglądaj najnowszy</a>
      </div>
      {hasHeroPhoto && <img class="hero-photo" src="/hero.jpg" alt="" />}
    </div>
  </div>
</section>
