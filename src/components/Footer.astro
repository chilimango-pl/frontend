---
import LogoMark from "./LogoMark.astro";
---

<footer id="kontakt">
  <div class="wrap">
    <div class="fgrid">
      <div>
        <a class="logo" href="/" style="color:#fff">
          <LogoMark />
          <span><span class="chili">Chili</span><span class="mango">mango</span></span>
        </a>
        <p>Filmy z podróży Marty i Bartka – Ameryka Środkowa, Europa i kolejne wyprawy.</p>
        <div class="social">
          <a href="https://www.youtube.com/@Chilimango" target="_blank" rel="noopener"
            ><svg width="20" height="14" viewBox="0 0 22 16" aria-hidden="true"
              ><rect width="22" height="16" rx="4" fill="#E63946"></rect><path
                d="M9 4.5v7l6-3.5z"
                fill="#fff"></path></svg
            >YouTube</a
          >
          <a href="https://www.instagram.com/_chilimango_/" target="_blank" rel="noopener"
            ><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
              ><rect
                x="2"
                y="2"
                width="20"
                height="20"
                rx="6"
                fill="none"
                stroke="#FF9F1C"
                stroke-width="2.5"></rect><circle
                cx="12"
                cy="12"
                r="4.5"
                fill="none"
                stroke="#FF9F1C"
                stroke-width="2.5"></circle><circle cx="17.5" cy="6.5" r="1.4" fill="#FF9F1C"
              ></circle></svg
            >Instagram</a
          >
          <a href="https://www.facebook.com/chilimangoworld" target="_blank" rel="noopener"
            >Facebook</a
          >
        </div>
      </div>
      <div>
        <h3>Serie</h3>
        <ul>
          <li><a href="#ca">Ameryka Środkowa z plecakiem</a></li>
          <li><a href="#eu">Europa rowerem i samochodem</a></li>
          <li><a href="#mapa">Mapa</a></li>
          <li><a href="#o-nas">O nas</a></li>
        </ul>
      </div>
      <div>
        <h3>Kontakt</h3>
        <ul>
          <li><a href="https://www.youtube.com/@Chilimango" target="_blank" rel="noopener">Kanał YouTube</a></li>
          <li><a href="#">Współpraca i media</a></li>
          <li><a href="#">Polityka prywatności</a></li>
        </ul>
      </div>
    </div>
    <div class="copy">
      <span>© 2026 Chilimango · chilimango.pl</span>
    </div>
  </div>
</footer>
