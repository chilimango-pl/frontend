---
import VideoCard from "./VideoCard.astro";
import { PLAYLIST_IDS, videosByPlaylist } from "../data/videos";

const items = videosByPlaylist("ameryka");
const playlistUrl = `https://www.youtube.com/playlist?list=${PLAYLIST_IDS.ameryka}`;
---

<div id="serie"></div>
<section id="ca" class="series" aria-labelledby="ca-h">
  <div class="wrap">
    <div class="series-head">
      <div>
        <span class="eyebrow"
          >Seria · <span class="count">20 filmów</span></span
        >
        <h2 id="ca-h">Ameryka Środkowa z plecakiem</h2>
        <p class="lead">
          Dominikana, Kostaryka, Nikaragua, Salwador, Gwatemala i Meksyk – 3 miesiące,
          19 odcinków i zwiastun.
        </p>
      </div>
      <a class="btn btn-green" href={playlistUrl} target="_blank" rel="noopener"
        >Cała playlista na YouTube →</a
      >
    </div>
    <div class="chips" role="group" aria-label="Filtruj odcinki według kraju" id="caChips">
      <button type="button" aria-pressed="true" data-f="*">Wszystkie</button>
      <button type="button" aria-pressed="false" data-f="do">🇩🇴 Dominikana</button>
      <button type="button" aria-pressed="false" data-f="cr">🇨🇷 Kostaryka</button>
      <button type="button" aria-pressed="false" data-f="ni">🇳🇮 Nikaragua</button>
      <button type="button" aria-pressed="false" data-f="sv">🇸🇻 Salwador</button>
      <button type="button" aria-pressed="false" data-f="gt">🇬🇹 Gwatemala</button>
      <button type="button" aria-pressed="false" data-f="mx">🇲🇽 Meksyk</button>
    </div>
    <div class="grid4" id="caGrid">
      {items.map((video, index) => <VideoCard video={video} index={index} />)}
    </div>
    <div class="more" id="caMore">
      <button
        class="btn btn-light"
        id="moreBtn"
        type="button"
        aria-expanded="false"
        aria-controls="caGrid"
        style="box-shadow:var(--shadow)">Pokaż wszystkie 20 odcinków ↓</button
      >
    </div>
  </div>
</section>
