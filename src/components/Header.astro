---
import LogoMark from "./LogoMark.astro";
---

<header>
  <div class="wrap nav">
    <a class="logo" href="/" aria-label="Chilimango – strona główna">
      <LogoMark />
      <span><span class="chili">Chili</span><span class="mango">mango</span></span>
    </a>
    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      aria-label="Otwórz menu">☰</button
    >
    <ul class="menu" id="menu">
      <li><a href="#serie">Podróże / Serie</a></li>
      <li><a href="#mapa">Mapa</a></li>
      <li><a href="#o-nas">O nas</a></li>
      <li><a href="#kontakt">Kontakt</a></li>
    </ul>
    <nav class="lang" aria-label="Wybór języka">
      <a href="/" class="lang__link lang__link--active" hreflang="pl" lang="pl">PL</a>
      <a href="/en/" class="lang__link" hreflang="en" lang="en">EN</a>
    </nav>
  </div>
</header>

<style>
  .lang__link {
    font: inherit;
    font-weight: 800;
    font-size: 0.8rem;
    padding: 5px 10px;
    border-radius: 99px;
    text-decoration: none;
    color: var(--muted);
  }
  .lang__link--active {
    background: var(--mango);
    color: var(--ink);
  }
</style>
